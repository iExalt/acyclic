# Native-context stages this source-free recipe, replacing the base digest,
# architecture and signed Release hashes for the requested platform.
FROM ubuntu:24.04@@BASE_DIGEST@@ AS native
ENV DEBIAN_FRONTEND=noninteractive \
    MISE_DATA_DIR=/opt/mise \
    MISE_CONFIG_DIR=/opt/mise-config \
    MISE_CONFIG_FILE=/opt/mise-config/mise.toml \
    RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    RUSTUP_TOOLCHAIN=@@RUST_VERSION@@ \
    PATH=/usr/local/bin:/opt/mise/shims:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

COPY snapshot/ /tmp/native-snapshot/
COPY bootstrap/ca-certificates.deb /tmp/native-bootstrap/ca-certificates.deb
RUN set -eu; \
    command -v gpgv >/dev/null 2>&1 || { echo 'pinned Ubuntu base has no gpgv' >&2; exit 1; }; \
    for release in noble noble-updates noble-security; do \
      case "$release" in \
        noble) expected=@@NOBLE_HASH@@ ;; \
        noble-updates) expected=@@UPDATES_HASH@@ ;; \
        noble-security) expected=@@SECURITY_HASH@@ ;; \
      esac; \
      printf '%s  %s\n' "$expected" "/tmp/native-snapshot/$release/InRelease" | sha256sum -c -; \
      gpgv --keyring /usr/share/keyrings/ubuntu-archive-keyring.gpg "/tmp/native-snapshot/$release/InRelease"; \
    done; \
    printf '%s  %s\n' '@@CA_PACKAGE_SHA@@' /tmp/native-bootstrap/ca-certificates.deb | sha256sum -c -; \
    mkdir -p /tmp/native-ca; dpkg-deb -x /tmp/native-bootstrap/ca-certificates.deb /tmp/native-ca; \
    cat /tmp/native-ca/usr/share/ca-certificates/mozilla/*.crt > /tmp/native-ca-bundle.crt; test -s /tmp/native-ca-bundle.crt; chmod 0644 /tmp/native-ca-bundle.crt; \
    rm -f /etc/apt/sources.list; rm -f /etc/apt/sources.list.d/*; rm -f /etc/apt/preferences /etc/apt/preferences.d/*; rm -f /etc/apt/apt.conf.d/*; rm -rf /var/lib/apt/lists/*; \
    printf '%s\n' \
      'deb [arch=@@ARCH@@] https://snapshot.ubuntu.com/ubuntu/@@SNAPSHOT@@ noble main universe' \
      'deb [arch=@@ARCH@@] https://snapshot.ubuntu.com/ubuntu/@@SNAPSHOT@@ noble-updates main universe' \
      'deb [arch=@@ARCH@@] https://snapshot.ubuntu.com/ubuntu/@@SNAPSHOT@@ noble-security main universe' \
      > /etc/apt/sources.list; \
    printf '%s\n' 'Acquire::Retries "3";' 'APT::Update::Error-Mode "any";' 'APT::Install-Recommends "false";' 'APT::Install-Suggests "false";' 'APT::Get::Always-Include-Phased-Updates "true";' \
      > /etc/apt/apt.conf.d/99native-ci; \
    apt-get -o Acquire::https::CaInfo=/tmp/native-ca-bundle.crt -o Acquire::https::Verify-Peer=true -o Acquire::https::Verify-Host=true update; \
    for suite in noble noble-updates noble-security; do \
      case "$suite" in noble) expected=@@NOBLE_HASH@@ ;; noble-updates) expected=@@UPDATES_HASH@@ ;; noble-security) expected=@@SECURITY_HASH@@ ;; esac; \
      list="$(find /var/lib/apt/lists -maxdepth 1 -type f -name "*_dists_${suite}_InRelease" -print -quit)"; \
      [ -n "$list" ] || { echo "missing fetched snapshot Release: $suite" >&2; exit 1; }; \
      printf '%s  %s\n' "$expected" "$list" | sha256sum -c -; \
    done; \
    apt-get -o Acquire::https::CaInfo=/tmp/native-ca-bundle.crt -o Acquire::https::Verify-Peer=true -o Acquire::https::Verify-Host=true install -y --no-remove --no-install-recommends @@PACKAGES@@; \
    mkdir -p /usr/share/native-ci; chmod 0755 /usr/share/native-ci; \
    LC_ALL=C dpkg-query -W -f='${binary:Package}\t${Version}\t${Architecture}\n' | LC_ALL=C sort > /usr/share/native-ci/dpkg-receipt.tsv; \
    rm -rf /var/lib/apt/lists/* /tmp/native-snapshot /tmp/native-bootstrap /tmp/native-ca /tmp/native-ca-bundle.crt

COPY mise.toml /opt/mise-config/mise.toml
RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) mise_sha=@@MISE_SHA@@; rust_target=x86_64-unknown-linux-musl ;; \
      arm64) mise_sha=@@MISE_SHA@@; rust_target=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    release=@@MISE_VERSION@@; \
    case "$arch" in amd64) asset_arch=x64 ;; arm64) asset_arch=arm64 ;; esac; \
    curl --fail --location --silent --show-error "https://github.com/jdx/mise/releases/download/v${release}/mise-v${release}-linux-${asset_arch}.tar.xz" -o /tmp/mise.tar.xz; \
    printf '%s  %s\n' "$mise_sha" /tmp/mise.tar.xz | sha256sum -c -; \
    tar -xJOf /tmp/mise.tar.xz mise/bin/mise > /usr/local/bin/mise; chmod 0755 /usr/local/bin/mise; \
    mise install; \
    mise exec -- rustup target add "$rust_target"; \
    mise exec -- rustup --version > /usr/share/native-ci/rustup-version.txt; \
    mise exec -- rustup component list --installed | LC_ALL=C sort > /usr/share/native-ci/rust-components.txt; \
    rm -f /tmp/mise.tar.xz; \
    chmod 0644 /usr/share/native-ci/*.txt /usr/share/native-ci/*.tsv; \
    chmod -R a+rX /opt/mise /opt/rustup /opt/cargo /opt/mise-config; \
    for tool in rustc cargo rustup cargo-about; do \
      selected="$(mise which "$tool")"; test -x "$selected"; \
      ln -s "$selected" "/usr/local/bin/$tool"; \
    done

RUN set -eu; \
    mkdir -p /workspace /output /home/builder/.cargo; chown 10001:10001 /workspace /output /home/builder /home/builder/.cargo; \
    chmod 0755 /workspace /output; chmod 0700 /home/builder /home/builder/.cargo
USER 10001:10001
WORKDIR /workspace
ENV HOME=/home/builder CC_x86_64_unknown_linux_musl=musl-gcc CC_aarch64_unknown_linux_musl=musl-gcc
LABEL org.opencontainers.image.title="Acyclic native Rust musl CI builder"
