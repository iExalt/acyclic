{
  "about": "The commands the app sends, as it sends them, and one it doesn't (an add without an id, which its form always gives), in an order that succeeds on a tracker holding item a, item b under a, item e done, thread t approved, and two proposals by an agent, $proposal-1 and $proposal-2. The app's unit tests check its builders make the ones they build; the server's tests run them through the API.",
  "examples": [
    {
      "name": "list",
      "command": "list"
    },
    {
      "name": "show",
      "command": {
        "show": {
          "items": ["a", "b"]
        }
      }
    },
    {
      "name": "threads",
      "command": {
        "thread": "list"
      }
    },
    {
      "name": "add under a parent, in a thread",
      "command": {
        "item": {
          "add": {
            "item": "c",
            "title": "C",
            "parent": "a",
            "thread": "t"
          }
        }
      }
    },
    {
      "name": "add at the top level",
      "command": {
        "item": {
          "add": {
            "item": "d",
            "title": "D"
          }
        }
      }
    },
    {
      "name": "add with an id the tracker assigns",
      "command": {
        "item": {
          "add": {
            "title": "F"
          }
        }
      }
    },
    {
      "name": "move to the top level",
      "command": {
        "item": {
          "edit": {
            "item": "c",
            "no-parent": true
          }
        }
      }
    },
    {
      "name": "move under a parent",
      "command": {
        "item": {
          "edit": {
            "item": "d",
            "parent": "a"
          }
        }
      }
    },
    {
      "name": "c waits for d",
      "command": {
        "link": {
          "add": {
            "from": "c",
            "kind": "waits-for",
            "to": "d"
          }
        }
      }
    },
    {
      "name": "c relates to b",
      "command": {
        "link": {
          "add": {
            "from": "c",
            "kind": "relates-to",
            "to": "b"
          }
        }
      }
    },
    {
      "name": "c no longer waits for d",
      "command": {
        "link": {
          "remove": {
            "from": "c",
            "kind": "waits-for",
            "to": "d"
          }
        }
      }
    },
    {
      "name": "edit an item's fields",
      "command": {
        "item": {
          "edit": {
            "item": "c",
            "title": "C2",
            "state": "in-progress",
            "thread": "t",
            "notes": "n",
            "gate": "g",
            "size": "m"
          }
        }
      }
    },
    {
      "name": "clear an item's fields",
      "command": {
        "item": {
          "edit": {
            "item": "c",
            "no-thread": true,
            "no-notes": true,
            "no-gate": true,
            "no-size": true
          }
        }
      }
    },
    {
      "name": "settle an item's parent as a clear",
      "command": {
        "item": {
          "edit": {
            "item": "d",
            "no-parent": true
          }
        }
      }
    },
    {
      "name": "settle a thread's title",
      "command": {
        "thread": {
          "edit": {
            "thread": "t",
            "title": "T"
          }
        }
      }
    },
    {
      "name": "settle a thread's brief as a clear",
      "command": {
        "thread": {
          "edit": {
            "thread": "t",
            "no-brief": true
          }
        }
      }
    },
    {
      "name": "reopen",
      "command": {
        "item": {
          "reopen": {
            "item": "e"
          }
        }
      }
    },
    {
      "name": "revoke",
      "command": {
        "thread": {
          "revoke": {
            "thread": "t"
          }
        }
      }
    },
    {
      "name": "approve",
      "command": {
        "thread": {
          "approve": {
            "thread": "t"
          }
        }
      }
    },
    {
      "name": "keep",
      "command": {
        "proposal": {
          "keep": {
            "proposal": "$proposal-1"
          }
        }
      }
    },
    {
      "name": "drop",
      "command": {
        "proposal": {
          "drop": {
            "proposal": "$proposal-2"
          }
        }
      }
    },
    {
      "name": "a thread's own level",
      "command": {
        "thread": {
          "edit": {
            "thread": "t",
            "level": "everything"
          }
        }
      }
    },
    {
      "name": "the global level for a thread",
      "command": {
        "thread": {
          "edit": {
            "thread": "t",
            "no-level": true
          }
        }
      }
    },
    {
      "name": "the global level",
      "command": {
        "level": {
          "level": "blockers"
        }
      }
    },
    {
      "name": "proposals",
      "command": {
        "proposal": "list"
      }
    },
    {
      "name": "a thread",
      "command": {
        "thread": {
          "show": {
            "threads": ["t"]
          }
        }
      }
    },
    {
      "name": "levels",
      "command": {
        "level": {}
      }
    },
    {
      "name": "needs",
      "command": "needs"
    },
    {
      "name": "keep a member the approval didn't see",
      "command": {
        "item": {
          "edit": {
            "item": "a",
            "thread": "t"
          }
        }
      }
    },
    {
      "name": "drop a member the approval didn't see",
      "command": {
        "item": {
          "edit": {
            "item": "b",
            "no-thread": true
          }
        }
      }
    }
  ]
}
