{
  "about": "The commands the app sends, as it sends them, and one it doesn't (an add without an id, which the app always gives), in an order that succeeds on a tracker holding one initiative, item a, item b under a, item e done and thread t. The app's unit tests check its builders make the ones they build; the server's tests run them through the API.",
  "examples": [
    {
      "name": "list",
      "command": {
        "item": "list"
      }
    },
    {
      "name": "show",
      "command": {
        "item": {
          "show": {
            "items": ["01900000-0000-7000-8000-0000000000a1", "01900000-0000-7000-8000-0000000000b1"]
          }
        }
      }
    },
    {
      "name": "initiatives",
      "command": {
        "initiative": "list"
      }
    },
    {
      "name": "threads",
      "command": {
        "thread": "list"
      }
    },
    {
      "name": "add under a parent, in a thread",
      "command": {
        "item": {
          "add": {
            "id": "01900000-0000-7000-8000-0000000000c1",
            "title": "C",
            "parent": "01900000-0000-7000-8000-0000000000a1",
            "thread": "01900000-0000-7000-8000-0000000000f1"
          }
        }
      }
    },
    {
      "name": "add with no parent, under the tracker's only initiative",
      "command": {
        "item": {
          "add": {
            "id": "01900000-0000-7000-8000-0000000000d1",
            "title": "D"
          }
        }
      }
    },
    {
      "name": "add with an id the tracker assigns",
      "command": {
        "item": {
          "add": {
            "title": "F"
          }
        }
      }
    },
    {
      "name": "move under a parent",
      "command": {
        "item": {
          "edit": {
            "item": "01900000-0000-7000-8000-0000000000d1",
            "parent": "01900000-0000-7000-8000-0000000000a1"
          }
        }
      }
    },
    {
      "name": "c waits for d",
      "command": {
        "item": {
          "edit": {
            "item": "01900000-0000-7000-8000-0000000000c1",
            "waits-for": ["01900000-0000-7000-8000-0000000000d1"]
          }
        }
      }
    },
    {
      "name": "c no longer waits for d",
      "command": {
        "item": {
          "edit": {
            "item": "01900000-0000-7000-8000-0000000000c1",
            "no-waits-for": ["01900000-0000-7000-8000-0000000000d1"]
          }
        }
      }
    },
    {
      "name": "edit an item's fields",
      "command": {
        "item": {
          "edit": {
            "item": "01900000-0000-7000-8000-0000000000c1",
            "title": "C2",
            "state": "parked",
            "thread": "01900000-0000-7000-8000-0000000000f1",
            "notes": "n"
          }
        }
      }
    },
    {
      "name": "clear an item's fields",
      "command": {
        "item": {
          "edit": {
            "item": "01900000-0000-7000-8000-0000000000c1",
            "no-thread": true,
            "no-notes": true
          }
        }
      }
    },
    {
      "name": "reopen",
      "command": {
        "item": {
          "reopen": {
            "item": "01900000-0000-7000-8000-0000000000e1"
          }
        }
      }
    },
    {
      "name": "a thread",
      "command": {
        "thread": {
          "show": {
            "threads": ["01900000-0000-7000-8000-0000000000f1"]
          }
        }
      }
    },
    {
      "name": "needs",
      "command": "needs"
    }
  ]
}
