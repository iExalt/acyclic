{
  "about": "The commands the app sends, as it sends them, and one it doesn't (an add without an id, which its form always gives), in an order that succeeds on a tracker holding item a, item b under a, item e done and thread t. The app's unit tests check its builders make the ones they build; the server's tests run them through the API.",
  "examples": [
    {
      "name": "list",
      "command": {
        "item": "list"
      }
    },
    {
      "name": "show",
      "command": {
        "item": {
          "show": {
            "items": ["a", "b"]
          }
        }
      }
    },
    {
      "name": "threads",
      "command": {
        "thread": "list"
      }
    },
    {
      "name": "add under a parent, in a thread",
      "command": {
        "item": {
          "add": {
            "item": "c",
            "title": "C",
            "parent": "a",
            "thread": "t"
          }
        }
      }
    },
    {
      "name": "add at the top level",
      "command": {
        "item": {
          "add": {
            "item": "d",
            "title": "D"
          }
        }
      }
    },
    {
      "name": "add with an id the tracker assigns",
      "command": {
        "item": {
          "add": {
            "title": "F"
          }
        }
      }
    },
    {
      "name": "move to the top level",
      "command": {
        "item": {
          "edit": {
            "item": "c",
            "no-parent": true
          }
        }
      }
    },
    {
      "name": "move under a parent",
      "command": {
        "item": {
          "edit": {
            "item": "d",
            "parent": "a"
          }
        }
      }
    },
    {
      "name": "c waits for d",
      "command": {
        "item": {
          "edit": {
            "item": "c",
            "waits-for": ["d"]
          }
        }
      }
    },
    {
      "name": "c no longer waits for d",
      "command": {
        "item": {
          "edit": {
            "item": "c",
            "no-waits-for": ["d"]
          }
        }
      }
    },
    {
      "name": "edit an item's fields",
      "command": {
        "item": {
          "edit": {
            "item": "c",
            "title": "C2",
            "state": "parked",
            "thread": "t",
            "notes": "n",
            "size": "m"
          }
        }
      }
    },
    {
      "name": "clear an item's fields",
      "command": {
        "item": {
          "edit": {
            "item": "c",
            "no-thread": true,
            "no-notes": true,
            "no-size": true
          }
        }
      }
    },
    {
      "name": "settle an item's parent as a clear",
      "command": {
        "item": {
          "edit": {
            "item": "d",
            "no-parent": true
          }
        }
      }
    },
    {
      "name": "settle a thread's title",
      "command": {
        "thread": {
          "edit": {
            "thread": "t",
            "title": "T"
          }
        }
      }
    },
    {
      "name": "settle a thread's brief as a clear",
      "command": {
        "thread": {
          "edit": {
            "thread": "t",
            "no-brief": true
          }
        }
      }
    },
    {
      "name": "reopen",
      "command": {
        "item": {
          "reopen": {
            "item": "e"
          }
        }
      }
    },
    {
      "name": "a thread",
      "command": {
        "thread": {
          "show": {
            "threads": ["t"]
          }
        }
      }
    },
    {
      "name": "needs",
      "command": "needs"
    }
  ]
}
